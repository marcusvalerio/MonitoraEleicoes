{
  "name": "monitora-eleicoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e": "node e2e/smoke.mjs",
    "e2e:real": "node e2e/real-debate.mjs",
    "e2e:real:pg": "EXPECT_PERSISTENCE=postgres node e2e/real-debate.mjs",
    "e2e:live": "node e2e/live-ingest.mjs",
    "debate": "node scripts/debate-control.mjs",
    "db:migrate": "node scripts/db-migrate.mjs --env development",
    "db:migrate:test": "node scripts/db-migrate.mjs --env test",
    "db:migrate:prod": "node scripts/db-migrate.mjs --env production --confirm-production",
    "db:status": "node scripts/db-migrate.mjs --status --env",
    "ingest": "node scripts/ingest.mjs",
    "ingest:g1": "node scripts/ingest-g1.mjs",
    "import:tse": "node scripts/import-tse.mjs",
    "e2e:g1": "node e2e/g1-editorial.mjs",
    "e2e:intel": "node e2e/intelligence.mjs",
    "e2e:product": "node e2e/real-product.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@svg-maps/brazil": "^2.0.0",
    "clsx": "^2.1.1",
    "jiti": "2.7.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
