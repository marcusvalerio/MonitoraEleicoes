# Perfil de dados: demo (padrão) | fixture (providers alternativos, teste de desacoplamento) | live
DATA_MODE=demo

# PostgreSQL (Neon). Somente nomes aqui — valores em .env.local (gitignored) ou no provedor de hospedagem.
# Ver docs/DATABASE.md.
DATABASE_URL=
# DATABASE_URL_TEST=         # branch 'test' (npm run test:db)
# DATABASE_URL_PRODUCTION=   # branch 'main' (só onde se opera produção)
# MONITORA_PG_TTL_MS=10000   # recarga do repositório PostgreSQL
# INGEST_TOKEN=              # habilita POST /api/ingest (só enfileira)
# ADMIN_TOKEN=               # habilita /admin/debates, /admin/inteligencia e /api/admin/*
# INGEST_DATASET_ID=validation-rj-2026-09-29
# MONITORA_LOG=silent

# Identidade (HMAC-SHA256 de título/CPF do TSE e de autores sociais). Obrigatória para importar TSE e coletar social.
# Gerar: openssl rand -hex 32. Trocar a chave invalida os vínculos (reimportar).
# IDENTITY_HASH_KEY=

# Social listening — somente APIs oficiais, somente no servidor. Nunca expor no frontend. Ver docs/SOCIAL-PROVIDERS.md.
# YOUTUBE_API_KEY=            # YouTube Data API v3 (Google Cloud)
# YOUTUBE_QUOTA_PER_RUN=1500  # orçamento de unidades por execução do monitor (cota padrão: 10 000/dia)
# X_API_BEARER_TOKEN=         # não implementado (plano pago)

# Fixtures/testes (nunca em produção):
# G1_ALLOWED_HOSTS=127.0.0.1:4599   # acrescenta hosts à allowlist do g1 (padrão: somente https://g1.globo.com)
# MONITORA_DATA_DIR=                # diretório alternativo de manifestos (E2E)
# MONITORA_DATASET_KIND=fixture     # worker grava dataset de fixture (produção recusa)
# NODE_USE_ENV_PROXY=1              # ambientes com proxy de saída obrigatório (fetch do Node não lê HTTPS_PROXY)
